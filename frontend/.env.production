# Production build environment variables
# These are baked into the JS bundle at build time by Vite.
# Set these values before running `npm run build` or inject them
# as Azure Web App Application Settings (prefixed VITE_) so the
# CI/CD pipeline can export them before building.
#
# DO NOT commit real keys — use Azure Portal / pipeline secrets instead.

VITE_AZURE_FUNCTION_KEY=<YOUR_RAG_FUNCTION_HOST_KEY>
VITE_AZURE_AGENT_FUNCTION_KEY=<YOUR_AGENT_FUNCTION_HOST_KEY>