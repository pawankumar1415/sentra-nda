# ── rag_function backend (custom approach) ───────────────────────────────────
# Base URL of the deployed Azure Function App (no trailing slash)
RAG_BASE_URL=https://your-rag-function.azurewebsites.net/api

# Credentials for the JWT auth route (POST /api/auth/login)
RAG_USERNAME=your_username
RAG_PASSWORD=your_password

# ── agent backend (Foundry approach) ─────────────────────────────────────────
# Base URL of the deployed Azure Function App (no trailing slash)
AGENT_BASE_URL=https://your-agent-function.azurewebsites.net/api

# Azure Functions host key (found in Azure Portal → Function App → App keys)
AGENT_FUNCTION_KEY=your_function_host_key