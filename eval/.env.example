# ── rag_function backend (custom approach) ───────────────────────────────────
# Base URL of the deployed Azure Function App (no trailing slash)
RAG_BASE_URL=https://your-rag-function.azurewebsites.net/api

# Azure Functions host key (Azure Portal → Function App → App keys → Host keys)
RAG_FUNCTION_KEY=your_rag_function_host_key

# JWT token for app-level auth — copy from browser:
#   DevTools → Application → Local Storage → find your token value
RAG_JWT_TOKEN=your_jwt_token_here

# ── agent backend (Foundry approach) ─────────────────────────────────────────
# Base URL of the deployed Azure Function App (no trailing slash)
AGENT_BASE_URL=https://your-agent-function.azurewebsites.net/api

# Azure Functions host key (Azure Portal → Function App → App keys → Host keys)
AGENT_FUNCTION_KEY=your_agent_function_host_key